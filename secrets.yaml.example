# secrets.yaml.example
# Copy this file to secrets.yaml and fill in real values.
# NEVER commit secrets.yaml to version control.
# secrets.yaml is listed in .gitignore.

version: "1"

# The private key of the wallet that funds simulation write transactions.
# Must be funded with Sepolia ETH (https://faucets.chain.link/sepolia).

privateKey: "REPLACE_WITH_YOUR_PRIVATE_KEY_WITHOUT_0x_PREFIX"
